<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:elevation="5dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="180"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="#1A1A1A" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/helpButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/button_outline"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_help"
                app:tint="#1A1A1A"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="600dp">

            <!-- EMAIL SECTION -->
            <LinearLayout
                android:id="@+id/emailSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Email Icon Circle -->
                <androidx.cardview.widget.CardView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/email"
                        android:layout_gravity="center"
                         />
                </androidx.cardview.widget.CardView>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your Email to Drive"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="28dp" />

                <!-- Email Input Box (like phone number style) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/email_input_box"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_email"
                        app:tint="#1E5BA8"
                        android:layout_marginEnd="12dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="#DDDDDD"
                        android:layout_marginEnd="12dp" />

                    <EditText
                        android:id="@+id/emailEditText"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="you@example.com"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:background="@android:color/transparent"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- OTP SECTION (hidden initially) -->
            <LinearLayout
                android:id="@+id/otpSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Back to email -->
                <LinearLayout
                    android:id="@+id/backToEmailLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="32dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:rotation="180"
                        app:tint="#1E5BA8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Change email"
                        android:textColor="#1E5BA8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Blue envelope icon -->
                <androidx.cardview.widget.CardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFF3E0">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/email"
                        android:layout_gravity="center"
                     />
                </androidx.cardview.widget.CardView>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Check your inbox"
                    android:textColor="#1A1A1A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="8dp" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="We sent a 6-digit code to"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Email chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/email_chip_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="36dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_email"
                        app:tint="#1E5BA8"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/otpSentToText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="you@example.com"
                        android:textColor="#1E5BA8"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- OTP label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Enter verification code"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="14dp" />

                <!-- OTP Boxes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/otp1"
                        android:layout_width="46dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/otp_box_inactive"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <EditText
                        android:id="@+id/otp2"
                        android:layout_width="46dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/otp_box_inactive"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <EditText
                        android:id="@+id/otp3"
                        android:layout_width="46dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/otp_box_inactive"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <EditText
                        android:id="@+id/otp4"
                        android:layout_width="46dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/otp_box_inactive"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <EditText
                        android:id="@+id/otp5"
                        android:layout_width="46dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/otp_box_inactive"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <EditText
                        android:id="@+id/otp6"
                        android:layout_width="46dp"
                        android:layout_height="58dp"
                        android:background="@drawable/otp_box_inactive"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />
                </LinearLayout>

                <!-- Resend row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Didn't receive the code? "
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/resendOtpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resend"
                        android:textColor="#1E5BA8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Section: Terms + Buttons -->
            <LinearLayout
                android:id="@+id/bottomSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Terms -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:text="Please read our Terms and conditions before proceeding"
                    android:textColor="#999999"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Change Email Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changeEmailButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Change registered email"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:backgroundTint="@color/white"
                    app:strokeColor="#CCCCCC"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="28dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Send OTP / Verify Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Proceed"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="#1E5BA8"
                    app:cornerRadius="28dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
