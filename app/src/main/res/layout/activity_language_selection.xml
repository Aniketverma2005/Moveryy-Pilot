<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/language_background_gradient">

    <!-- Help Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/helpButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Help"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:backgroundTint="#2A5A8F"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_help"
        app:iconTint="@color/white"
        app:iconGravity="start"
        app:iconPadding="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preview - Large Language Text (Initially Hidden) -->
    <TextView
        android:id="@+id/previewCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGLISH"
        android:textColor="#2A5A8F"
        android:textSize="100sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:alpha="0.25"
        android:letterSpacing="0.05"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/languageSelectionCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <!-- Language Bubbles Illustration (Initially Visible) -->
    <LinearLayout
        android:id="@+id/illustrationContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/languageSelectionCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Hindi Bubble -->
        <androidx.cardview.widget.CardView
            android:id="@+id/hindiBubble"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#3D6A9F"
            android:layout_marginEnd="-20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="आ"
                android:textSize="72sp"
                android:textColor="#6B8FB8"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </androidx.cardview.widget.CardView>

        <!-- English Bubble -->
        <androidx.cardview.widget.CardView
            android:id="@+id/englishBubble"
            android:layout_width="160dp"
            android:layout_height="160dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#4A7AAD"
            android:layout_marginTop="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textSize="88sp"
                android:textColor="#7A9FC4"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </androidx.cardview.widget.CardView>

        <!-- Decorative Plus -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="32sp"
            android:textColor="#5A8ABB"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-40dp" />

        <!-- Decorative Star -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textSize="24sp"
            android:textColor="#5A8ABB"
            android:layout_marginStart="-80dp"
            android:layout_marginTop="100dp" />

    </LinearLayout>

    <!-- Language Selection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/languageSelectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="40dp">

            <!-- Title -->
            <TextView
                android:id="@+id/selectLanguageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select App Language"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <!-- Language Grid -->
            <GridLayout
                android:id="@+id/languageGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignBounds"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="24dp">

                <!-- English -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEnglish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="start"
                        android:background="@drawable/language_card_unselected">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="English"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audio Wave (Initially Hidden) -->
                                <ImageView
                                    android:id="@+id/audioWaveEnglish"
                                    android:layout_width="60dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/audio_wave"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsEnglish"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••••••••"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <View
                                android:id="@+id/checkEnglish"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/radio_button_unselected"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Hindi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHindi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="start">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="हिन्दी"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audio Wave (Initially Hidden) -->
                                <ImageView
                                    android:id="@+id/audioWaveHindi"
                                    android:layout_width="60dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/audio_wave"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsHindi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••••••••"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <View
                                android:id="@+id/checkHindi"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/radio_button_unselected"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Spanish -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSpanish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="start">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="বাংলা"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audio Wave (Initially Hidden) -->
                                <ImageView
                                    android:id="@+id/audioWaveBengali"
                                    android:layout_width="60dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/audio_wave"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsBengali"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••••••••"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <View
                                android:id="@+id/checkSpanish"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/radio_button_unselected"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Marathi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFrench"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="start">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="मराठी"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audio Wave (Initially Hidden) -->
                                <ImageView
                                    android:id="@+id/audioWaveMarathi"
                                    android:layout_width="60dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/audio_wave"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsMarathi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••••••••"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <View
                                android:id="@+id/checkFrench"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/radio_button_unselected"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Malayalam -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGerman"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="start">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="മലയാളം"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audio Wave (Initially Hidden) -->
                                <ImageView
                                    android:id="@+id/audioWaveMalayalam"
                                    android:layout_width="60dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/audio_wave"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsMalayalam"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••••••••"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <View
                                android:id="@+id/checkGerman"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/radio_button_unselected"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Kannada -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardArabic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="start">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ಕನ್ನಡ"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audio Wave (Initially Hidden) -->
                                <ImageView
                                    android:id="@+id/audioWaveKannada"
                                    android:layout_width="60dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/audio_wave"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsKannada"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <!-- Dots (Initially Visible) -->
                                <TextView
                                    android:id="@+id/dotsKannada"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••••••••"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <View
                                android:id="@+id/checkArabic"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/radio_button_unselected"
                                android:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- Confirm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:backgroundTint="#E8E8E8"
                app:cornerRadius="28dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
